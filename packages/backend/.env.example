# Written by `pnpm worktree:setup` (local anonymous backend). Do not point a
# worktree at a cloud deployment; see scripts/setup-worktree.mjs.
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
CONVEX_URL=http://127.0.0.1:3210
CONVEX_AGENT_MODE=anonymous

# Deployment env vars (set with `pnpm exec convex env set`, not in this file):
#   LOGTO_ENDPOINT             e.g. https://auth.example.com (no trailing /oidc)
#   LOGTO_APP_ID               the Logto *Traditional web* application id
#   LOGTO_CLIENT_SECRET        that application's secret
#   LOGTO_WEBHOOK_SIGNING_KEY  optional, enables POST /logto/webhook
